{
	"manifest_version": 2,
	"name": "Twitter to Nitter",
	"version": "1.3",
	"description": "Redirects Twitter to Nitter for a private, ad-free experience.",
    "browser_specific_settings": {
        "gecko": {
            "id": "twitter2nitter@a-catgirl.dev",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            },
            "strict_min_version": "58.0"
        }
    },
	"permissions": [
		"webNavigation",
		"*://twitter.com/*",
		"*://x.com/*",
        "storage"
	],
	"background": {
		"scripts": ["background.js"],
		"persistent": false
	},
    "browser_action": {
        "browser_style": false,
        "default_popup": "popup.html"
    }
}
